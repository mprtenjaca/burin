{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    /*
     * `node` je dodan uz `jest` na SDK 57 (7.8.2026.). Ovo je IZRIČIT
     * popis — što nije navedeno, ne učitava se, pa su testovi ostali bez
     * `global` i `require.resolve` kad ih baza Expa prestala nositi.
     * `@types/node` je i dalje instaliran, samo nije bio uključen.
     */
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
