    "expo-dev-client": "~6.0.21",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "fast-xml-parser": "^5.10.1",
    "lucide-react-native": "^1.28.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
