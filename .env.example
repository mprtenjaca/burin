# OpenWeatherMap — obojeni slojevi karte (Temperatura / Naoblaka / Vjetar).
# Bez ključa: ti čipovi su sivi s napomenom "Potreban OWM ključ", a Radar
# oborina i sve ostalo radi normalno.
EXPO_PUBLIC_OWM_API_KEY=

# Windy Webcams — sekcija "Kamere" ispod karte na početnoj.
# Besplatan ključ: https://api.windy.com/keys
#
# Bez ključa se sekcija NE PRIKAZUJE, sve ostalo radi normalno (isto
# pravilo kao OWM). Napomena: Windyjev "live" su ZADNJE SNIMLJENE SLIKE,
# ne video, a URL-ovi slika istječu za 10 min na besplatnoj razini — pa
# kamere ne rade offline.
EXPO_PUBLIC_WINDY_API_KEY=
