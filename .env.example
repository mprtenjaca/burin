# OpenWeatherMap — dodatni slojevi karte (Temperatura / Naoblaka / Vjetar / Oborine).
# Bez ključa: ti slojevi su skriveni, sve ostalo radi normalno.
EXPO_PUBLIC_OWM_API_KEY=

# Google Maps Android API ključ (react-native-maps, provider Google).
# Bez ključa: na Androidu je ekran karte neupotrebljiv (prazna podloga, a ni
# radarske pločice se ne prikazuju — react-native-maps issue #5156).
# Ostatak aplikacije radi i bez njega.
GOOGLE_MAPS_API_KEY=
